# graft local graph cache
/graft/
**/graft/.cache/
**/graft/.graph/

# OS junk
.DS_Store

# Python cache
__pycache__/
*.pyc
*.pyc.py

# Episode production output and series-specific files — kept locally, never in repo.
# All generated media, production artifacts, and creator-specific tracking files
# belong outside version control.
episodes/
series-log.md
playlists/
youtube-upload-checklist.md

# Channel identity — creator fills this in locally; never commit it.
# Copy channel-config.md.example to channel-config.md and fill in your own details.
channel-config.md

# Hook cache
.claude/hooks/__pycache__/

# Unrelated plugins — managed separately, not part of this repo
:LinkedIn-blog-architect/
.agents/
.claude/skills/higgsfield-*

# Local machine settings
.claude/settings.local.json

# Secrets — never commit
.env
*.env
.env.*
assets/presenter/real/

# Creator-specific media and series files: these belong to one channel, not to the toolkit
MCP-Zero-to-Hero-Production-Bible.md
*-youtube-channel-banner.jpg
youtube-profile-image.jpg
*youtube-thumbnail-sample*.jpg
assets/presenter/*
!assets/presenter/README.md
assets/music/*
!assets/music/README.md
assets/hosts/

# Per-episode workfiles that may hold keys or personal details
*.local.json
